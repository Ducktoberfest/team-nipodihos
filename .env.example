# Copy to .env and fill in. NEVER commit .env.
# Both models are open-weight (Apache 2.0). You need at least one key; both is best.

# --- Gemma 4 via Google AI Studio: reads/normalises reports ---
# Key: https://aistudio.google.com/apikey  (the MODEL name decides Gemma vs Gemini;
# the code only allows gemma-* models)
GEMINI_API_KEY=

# --- gpt-oss via Groq: compares candidates ---
# Key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional overrides (comma-separated provider:model, first = preferred)
# MODEL_CHAIN_EXTRACT=google:gemma-4-26b-a4b-it,groq:openai/gpt-oss-120b
# MODEL_CHAIN_COMPARE=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,google:gemma-4-26b-a4b-it
AI_TIMEOUT_SECONDS=20
